<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- スモークテストから写真壁紙の編集画面を開くため (debug ビルドのみ外部から起動できる) -->
        <activity
            android:name="com.aa.launcher.settings.WallpaperCropActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <!-- スモークテストで擬似の再生中メディアを作る (Dynamic Island の確認用) -->
        <receiver
            android:name="com.aa.launcher.debugtools.DebugMediaReceiver"
            android:exported="true" />
    </application>
</manifest>
